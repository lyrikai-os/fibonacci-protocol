{
  "fp": "1.0.0-rc.3",
  "mode": "snap",
  "level": "FP-1",
  "platform": "web",
  "unit": 1,
  "has": {
    "motion": false,
    "timeLimits": false,
    "controls": true,
    "charts": false,
    "generatedArt": false,
    "states": false
  },
  "source": [
    "input.css"
  ],
  "pairs": [
    {
      "fg": "#1a1a1a",
      "bg": "#ffffff",
      "kind": "text"
    }
  ],
  "snap": {
    "source": [
      "input.css"
    ]
  },
  "roles": [
    {
      "match": "--control-*",
      "role": "target"
    },
    {
      "match": "--button-drawn",
      "role": "drawn"
    },
    {
      "match": "--icon-*",
      "role": "icon"
    }
  ]
}
